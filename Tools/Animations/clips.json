    "GoblinQueen": "Animation Testing/ExtraSkins/GoblinQueen/GoblinQueen.fbx",
    "ImpMother": "Animation Testing/ExtraSkins/ImpMother/ImpMother.fbx",
    "Rat": "Animation Testing/ExtraSkins/Rat/Rat.fbx"
  },
  "_outfit_help": "Outfits whose model was re-posed (see flatten_feet.py) get their own neutral pose re-fitted from the original in outfit_clip_folders.",
